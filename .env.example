# better-auth (auth data only — all app data lives in the Express API)
DB_URL="mongodb://localhost:27017"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="replace-with-a-long-random-string"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Express API — all app CRUD and Stripe Checkout go through this backend.
# On Vercel this must be the deployed backend URL (no trailing slash).
NEXT_PUBLIC_API_URL="http://localhost:5000"

# Stripe keys belong ONLY to the backend project:
# equipment-rental-platform-server/.env (STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET)
